<div class="fhql-sheet">
{{#with sheet}}
<div class="fhql-sheet-inner">
  {{#if image}}{{#unless editing}}<img class="fhql-banner" src="{{image}}" alt="">{{/unless}}{{/if}}

  {{! ---------- Header ---------- }}
  <header class="fhql-sheet-head">
    {{#if editing}}
    <div class="fhql-portrait fhql-portrait-drop" data-drop="giver">
      {{#if giver.img}}<img src="{{giver.img}}" alt="">{{else}}<i class="fa-solid fa-user-plus" inert></i>{{/if}}
      <span class="fhql-portrait-hint">{{localize "FHQL.Quest.DropGiver"}}</span>
    </div>
    {{else if giver.linked}}
    <button type="button" class="fhql-portrait" data-action="openDocument" data-uuid="{{giver.uuid}}"
            data-tooltip="{{giver.name}}" aria-label="{{giver.name}}">
      {{#if giver.img}}<img src="{{giver.img}}" alt="">{{else}}<i class="fa-solid fa-user-shield" inert></i>{{/if}}
    </button>
    {{else}}
    <div class="fhql-portrait">
      {{#if giver.img}}<img src="{{giver.img}}" alt="">{{else}}<i class="fa-solid fa-scroll" inert></i>{{/if}}
    </div>
    {{/if}}

    <div class="fhql-sheet-title">
      {{#if editing}}
      <input type="text" class="fhql-input fhql-title-input" name="name" data-field="name" value="{{name}}"
             aria-label="{{localize 'FHQL.Quest.Name'}}">
      {{else}}
      <h2 class="fhql-heading">{{name}}</h2>
      {{/if}}
    </div>

    {{#if gm}}
    <button type="button" class="fhql-icon-button fhql-menu" data-action="questMenu" aria-haspopup="menu"
            aria-label="{{localize 'FHQL.Quest.MoreActions'}}" data-tooltip="{{localize 'FHQL.Quest.MoreActions'}}">
      <i class="fa-solid fa-ellipsis-vertical" inert></i></button>
    {{else}}
    <span></span>
    {{/if}}

    <div class="fhql-sheet-meta">
      <span class="fhql-status-badge fhql-status-{{status}}"><i class="{{statusIcon}}" inert></i> {{statusLabel}}</span>
      {{#if inProgress}}<i class="fa-solid fa-star fhql-in-progress" data-tooltip="{{localize 'FHQL.Quest.InProgress'}}" aria-label="{{localize 'FHQL.Quest.InProgress'}}"></i>{{/if}}
      {{#if giver.name}}<span class="fhql-sep">·</span><span>{{giver.name}}</span>{{/if}}
      {{#if parent}}<span class="fhql-sep">·</span><span>{{localize "FHQL.Quest.PartOf"}}
        <button type="button" class="fhql-link" data-action="showQuest" data-quest-id="{{parent.id}}">{{parent.name}}</button></span>{{/if}}
      {{#if dateLine}}<span class="fhql-sep">·</span><span class="fhql-dates">{{dateLine}}</span>{{/if}}
    </div>

    {{#if editing}}
    <div class="fhql-sheet-actions">
      <span class="fhql-muted"><i class="fa-solid fa-pen" inert></i> {{localize "FHQL.QuestLog.EditingNote"}}</span>
      <span class="fhql-save-state" data-save-state role="status">{{saveStateLabel}}</span>
      <button type="button" class="fhql-button fhql-primary fhql-push" data-action="finishEditing">
        <i class="fa-solid fa-check" inert></i> {{localize "FHQL.QuestLog.Done"}}</button>
    </div>
    <div class="fhql-sheet-fields">
      <label class="fhql-field">
        <span>{{localize "FHQL.Quest.Status"}}</span>
        <select class="fhql-input" name="status" data-field="status" {{#unless canSetStatus}}disabled{{/unless}}>
          {{#each statusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      <label class="fhql-field fhql-grow">
        <span>{{localize "FHQL.Quest.Giver"}}</span>
        <span class="fhql-inline">
          <input type="text" class="fhql-input" name="giver.name" data-field="giver.name" value="{{giver.name}}">
          {{#if giver.linked}}<button type="button" class="fhql-icon-button" data-action="clearGiver"
            data-tooltip="{{localize 'FHQL.Quest.ClearGiver'}}" aria-label="{{localize 'FHQL.Quest.ClearGiver'}}"><i class="fa-solid fa-link-slash" inert></i></button>{{/if}}
        </span>
      </label>
      {{#if gm}}
      <label class="fhql-check">
        <input type="checkbox" name="inProgress" data-field="inProgress" {{#if inProgress}}checked{{/if}}>
        <span>{{localize "FHQL.Quest.InProgress"}}</span>
      </label>
      {{/if}}
      <label class="fhql-field fhql-grow">
        <span>{{localize "FHQL.Quest.Image"}}</span>
        <file-picker name="image" type="image" value="{{image}}" data-field="image"></file-picker>
      </label>
    </div>
    {{else}}
    <div class="fhql-sheet-actions">
      {{#each statusActions}}
      <button type="button" class="fhql-button fhql-status-{{status}}" data-action="setQuestStatus" data-status="{{status}}"
              aria-label="{{label}}" data-tooltip="{{label}}">
        <i class="{{icon}} fhql-status-icon" inert></i><span class="fhql-label">{{label}}</span></button>
      {{/each}}
      {{#if gm}}
      <button type="button" class="fhql-button fhql-toggle {{#if inProgress}}is-on{{/if}}" data-action="toggleInProgress"
              aria-pressed="{{#if inProgress}}true{{else}}false{{/if}}" data-tooltip="{{localize 'FHQL.Quest.InProgressHint'}}"
              aria-label="{{localize 'FHQL.Quest.InProgress'}}">
        <i class="{{#if inProgress}}fa-solid{{else}}fa-regular{{/if}} fa-star" inert></i><span class="fhql-label">{{localize "FHQL.Quest.InProgress"}}</span></button>
      {{/if}}
      {{#if canAccept}}
      <button type="button" class="fhql-button fhql-primary" data-action="acceptQuest" data-tooltip="{{localize 'FHQL.Player.AcceptHint'}}"
              aria-label="{{localize 'FHQL.Player.Accept'}}"><i class="fa-solid fa-flag" inert></i><span class="fhql-label">{{localize "FHQL.Player.Accept"}}</span></button>
      {{/if}}
      <button type="button" class="fhql-button fhql-toggle {{#if tracked}}is-on{{/if}}" data-action="toggleTracked"
              aria-pressed="{{#if tracked}}true{{else}}false{{/if}}" aria-label="{{localize 'FHQL.Quest.Track'}}"
              data-tooltip="{{#if tracked}}{{localize 'FHQL.Quest.UntrackHint'}}{{else}}{{localize 'FHQL.Quest.TrackHint'}}{{/if}}">
        <i class="{{#if tracked}}fa-solid{{else}}fa-regular{{/if}} fa-bookmark" inert></i><span class="fhql-label">{{localize "FHQL.Quest.Track"}}</span></button>
      {{#if editable}}
      <button type="button" class="fhql-button fhql-push" data-action="editQuest" aria-label="{{localize 'FHQL.QuestLog.Edit'}}">
        <i class="fa-solid fa-pen" inert></i><span class="fhql-label">{{localize "FHQL.QuestLog.Edit"}}</span></button>
      {{/if}}
    </div>
    {{/if}}
  </header>

  {{#if showHiddenNotice}}
  <p class="fhql-notice"><i class="fa-solid fa-eye-slash" inert></i> {{localize "FHQL.QuestLog.HiddenNotice"}}</p>
  {{/if}}

  {{#if full}}
  <div class="fhql-sheet-body">
    <div class="fhql-col">

      {{! ---------- Description ---------- }}
      {{#if editing}}
      <section class="fhql-card fhql-area-description">
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.Description"}}</h3>
        <prose-mirror name="description" data-field="description" toggled value="{{description}}">{{{descriptionHTML}}}</prose-mirror>
      </section>
      {{else if descriptionHTML}}
      <section class="fhql-card fhql-area-description">
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.Description"}}</h3>
        <div class="fhql-prose">{{{descriptionHTML}}}</div>
      </section>
      {{/if}}

      {{! ---------- Player notes: edited in place, by one person at a time, in either view ---------- }}
      {{#if notesEditing}}
      <section class="fhql-card fhql-area-notes">
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.PlayerNotes"}}
          <button type="button" class="fhql-button fhql-small fhql-primary fhql-push" data-action="finishNotes"
            aria-label="{{localize 'FHQL.Notes.Done'}}"><i class="fa-solid fa-check" inert></i><span class="fhql-label">{{localize "FHQL.Notes.Done"}}</span></button></h3>
        <prose-mirror name="playerNotes" data-field="playerNotes" toggled value="{{playerNotes}}">{{{playerNotesHTML}}}</prose-mirror>
      </section>
      {{else if playerNotesHTML}}
      <section class="fhql-card fhql-area-notes">
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.PlayerNotes"}}
          {{#if notesLockedBy}}<span class="fhql-empty-note fhql-push"><i class="fa-solid fa-lock" inert></i> {{notesLockedBy}}</span>
          {{#if notesTakeOver}}<button type="button" class="fhql-button fhql-small" data-action="editNotes" data-force
            aria-label="{{localize 'FHQL.Notes.TakeOver'}}" data-tooltip="{{localize 'FHQL.Notes.TakeOverHint'}}"><i class="fa-solid fa-pen" inert></i><span class="fhql-label">{{localize "FHQL.Notes.TakeOver"}}</span></button>{{/if}}
          {{else if notesCanStart}}<button type="button" class="fhql-button fhql-small fhql-push" data-action="editNotes"
            aria-label="{{localize 'FHQL.Player.EditNotes'}}"><i class="fa-solid fa-pen" inert></i><span class="fhql-label">{{localize "FHQL.Player.EditNotes"}}</span></button>{{/if}}</h3>
        <div class="fhql-prose">{{{playerNotesHTML}}}</div>
      </section>
      {{else if canEditNotes}}
      <section class="fhql-card fhql-compact fhql-area-notes">
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.PlayerNotes"}}<span class="fhql-empty-note">{{localize "FHQL.Section.Empty"}}</span>
          {{#if notesLockedBy}}<span class="fhql-empty-note fhql-push"><i class="fa-solid fa-lock" inert></i> {{notesLockedBy}}</span>
          {{#if notesTakeOver}}<button type="button" class="fhql-button fhql-small" data-action="editNotes" data-force
            aria-label="{{localize 'FHQL.Notes.TakeOver'}}" data-tooltip="{{localize 'FHQL.Notes.TakeOverHint'}}"><i class="fa-solid fa-pen" inert></i><span class="fhql-label">{{localize "FHQL.Notes.TakeOver"}}</span></button>{{/if}}
          {{else if notesCanStart}}<button type="button" class="fhql-button fhql-small" data-action="editNotes"
            aria-label="{{localize 'FHQL.Player.AddNotes'}}"><i class="fa-solid fa-plus" inert></i><span class="fhql-label">{{localize "FHQL.Player.AddNotes"}}</span></button>{{/if}}</h3>
      </section>
      {{/if}}
    </div>

    <div class="fhql-col">

      {{! ---------- Objectives ---------- }}
      {{#if showObjectives}}
      <section class="fhql-card fhql-area-objectives">
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.Objectives"}}
          <span class="fhql-count">{{doneCount}}/{{objectives.length}}</span></h3>
        <ul class="fhql-objectives">
          {{#each objectives}}
          <li class="is-{{state}} {{#if requirement}}has-requirement{{/if}}" data-objective-id="{{id}}"
              {{#if ../editing}}data-drop="requirement"{{else if canDeposit}}data-deposit{{/if}}>
            {{#if ../editable}}
            <button type="button" class="fhql-icon-button" data-action="cycleObjective" data-tooltip="{{stateLabel}}"
                    aria-label="{{stateLabel}}"><i class="fhql-state-icon {{icon}}" inert></i></button>
            {{else}}
            <i class="fhql-state-icon {{icon}}" aria-label="{{stateLabel}}"></i>
            {{/if}}
            {{#if ../editing}}
            <input type="text" class="fhql-input" name="objective-{{id}}" data-field="objective.name" value="{{name}}"
                   placeholder="{{localize 'FHQL.Objective.Placeholder'}}" aria-label="{{localize 'FHQL.Objective.Name'}}">
            {{#if ../gm}}
            <button type="button" class="fhql-icon-button fhql-eye" data-action="toggleObjectiveHidden" aria-pressed="{{#if hidden}}true{{else}}false{{/if}}"
                    data-tooltip="{{#if hidden}}{{localize 'FHQL.Objective.Show'}}{{else}}{{localize 'FHQL.Objective.HideAction'}}{{/if}}"
                    aria-label="{{#if hidden}}{{localize 'FHQL.Objective.Show'}}{{else}}{{localize 'FHQL.Objective.HideAction'}}{{/if}}">
              <i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}" inert></i></button>
            {{/if}}
            <button type="button" class="fhql-icon-button" data-action="deleteObjective"
                    data-tooltip="{{localize 'FHQL.Objective.Delete'}}" aria-label="{{localize 'FHQL.Objective.Delete'}}">
              <i class="fa-solid fa-trash" inert></i></button>
            {{else}}
            <span class="fhql-grow-text">{{name}}</span>
            {{#if ../gm}}
            <button type="button" class="fhql-icon-button fhql-eye" data-action="toggleObjectiveHidden" aria-pressed="{{#if hidden}}true{{else}}false{{/if}}"
                    data-tooltip="{{#if hidden}}{{localize 'FHQL.Objective.Show'}}{{else}}{{localize 'FHQL.Objective.HideAction'}}{{/if}}"
                    aria-label="{{#if hidden}}{{localize 'FHQL.Objective.Show'}}{{else}}{{localize 'FHQL.Objective.HideAction'}}{{/if}}">
              <i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}" inert></i></button>
            {{/if}}
            {{/if}}
            {{#if requirement}}
            <div class="fhql-requirement {{#if requirement.met}}is-met{{/if}}">
              <span class="fhql-requirement-item">
                <span class="fhql-requirement-thumb">{{#if requirement.img}}<img src="{{requirement.img}}" alt="">{{else}}<i class="fa-solid fa-box" inert></i>{{/if}}</span>
                <button type="button" class="fhql-link" data-action="openDocument" data-uuid="{{requirement.uuid}}">{{requirement.name}}</button>
                <span class="fhql-requirement-progress" style="--fhql-fill: {{requirement.fill}}" aria-label="{{localize 'FHQL.Deposit.Progress'}} {{requirement.progress}}">{{requirement.progress}}</span>
                {{#unless ../editing}}{{#unless canDeposit}}<span class="fhql-muted">{{requirement.modeLabel}}</span>{{/unless}}{{/unless}}
              </span>
              {{#if canDeposit}}
              <button type="button" class="fhql-button fhql-small fhql-primary" data-action="depositItem" aria-label="{{depositAria}}">
                <i class="fa-solid {{depositIcon}}" inert></i><span class="fhql-label">{{depositVerb}}</span></button>
              {{#if depositChoose}}<button type="button" class="fhql-button fhql-small fhql-deposit-from" data-action="depositItemFrom"
                aria-haspopup="menu" aria-label="{{depositChooseLabel}}" data-tooltip="{{depositChooseLabel}}"><i class="fa-solid fa-caret-down" inert></i></button>{{/if}}
              {{/if}}
              {{#if ../editing}}
              <span class="fhql-requirement-edit">
                <input type="number" min="1" step="1" class="fhql-input fhql-count-input" data-field="objective.count" value="{{requirement.count}}"
                       aria-label="{{localize 'FHQL.Deposit.Count'}}" data-tooltip="{{localize 'FHQL.Deposit.Count'}}">
                <select class="fhql-input fhql-small-select" data-field="objective.mode" aria-label="{{localize 'FHQL.Deposit.ModeLabel'}}">
                  {{#each requirement.modeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
                <button type="button" class="fhql-icon-button" data-action="clearRequirement"
                        data-tooltip="{{localize 'FHQL.Deposit.Clear'}}" aria-label="{{localize 'FHQL.Deposit.Clear'}}"><i class="fa-solid fa-xmark" inert></i></button>
              </span>
              {{/if}}
              {{#if depositsList.length}}
              <span class="fhql-deposits">
                {{#each depositsList}}
                <span class="fhql-claim"><i class="fa-solid fa-check" inert></i> {{label}}
                  {{#if gm}}<button type="button" class="fhql-link fhql-undo" data-action="undoDeposit" data-deposit-index="{{index}}"
                    data-tooltip="{{localize 'FHQL.Deposit.Undo'}}" aria-label="{{localize 'FHQL.Deposit.Undo'}}"><i class="fa-solid fa-rotate-left" inert></i></button>{{/if}}
                </span>
                {{/each}}
              </span>
              {{/if}}
            </div>
            {{/if}}
          </li>
          {{/each}}
        </ul>
        {{#if editing}}
        <div class="fhql-objectives-drop" data-drop="objectives">
          <button type="button" class="fhql-button fhql-add" data-action="addObjective">
            <i class="fa-solid fa-plus" inert></i> {{localize "FHQL.Objective.Add"}}</button>
          <p class="fhql-hint">{{localize "FHQL.Deposit.DropHint"}}</p>
        </div>
        {{/if}}
      </section>
      {{else if editable}}
      <section class="fhql-card fhql-compact fhql-area-objectives">
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.Objectives"}}<span class="fhql-empty-note">{{localize "FHQL.Section.NoneYet"}}</span></h3>
      </section>
      {{/if}}

      {{! ---------- Subquests ---------- }}
      {{#if subquests.length}}
      <section class="fhql-card fhql-area-subquests">
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.Subquests"}}
          <span class="fhql-count">{{subquests.length}}</span>
          {{#if gm}}<button type="button" class="fhql-button fhql-small" data-action="addSubquest" aria-label="{{localize 'FHQL.Quest.AddSubquestLabel'}}" data-tooltip="{{localize 'FHQL.Quest.AddSubquestLabel'}}"><i class="fa-solid fa-plus" inert></i><span class="fhql-label">{{localize "FHQL.Quest.AddSubquest"}}</span></button>{{/if}}
        </h3>
        <ul class="fhql-rows">
          {{#each subquests}}
          <li class="fhql-status-{{status}}">
            <button type="button" class="fhql-row-link" data-action="showQuest" data-quest-id="{{id}}">
              <span class="fhql-thumb"><i class="{{icon}} fhql-status-icon" inert></i></span>
              <span class="fhql-row-name">{{name}}</span>
              <span class="fhql-row-status">{{label}}</span>
            </button>
          </li>
          {{/each}}
        </ul>
      </section>
      {{else if gm}}
      <section class="fhql-card fhql-compact fhql-area-subquests">
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.Subquests"}}<span class="fhql-empty-note">{{localize "FHQL.Section.None"}}</span>
          <button type="button" class="fhql-button fhql-small" data-action="addSubquest" aria-label="{{localize 'FHQL.Quest.AddSubquestLabel'}}" data-tooltip="{{localize 'FHQL.Quest.AddSubquestLabel'}}"><i class="fa-solid fa-plus" inert></i><span class="fhql-label">{{localize "FHQL.Quest.AddSubquest"}}</span></button></h3>
      </section>
      {{/if}}

      {{! ---------- Rewards ---------- }}
      {{#if showRewards}}
      <section class="fhql-card fhql-area-rewards" {{#if editable}}data-drop="rewards"{{/if}}>
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.Rewards"}}
          <span class="fhql-count">{{#if rewardSummary}}{{rewardSummary}}{{else}}{{rewards.length}}{{/if}}</span></h3>
        <ul class="fhql-rewards {{#if editing}}is-editing{{/if}}">
          {{#each rewards}}
          <li class="fhql-reward {{#if struck}}is-claimed{{/if}}" data-reward-id="{{id}}"
              {{#if draggable}}draggable="true" data-reward-drag data-uuid="{{uuid}}"{{/if}}>
            <span class="fhql-thumb">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="{{icon}}" inert></i>{{/if}}</span>

            <div class="fhql-reward-main">
              {{#if (lookup ../textRewardEditing type)}}
              <input type="text" class="fhql-input" name="reward-{{id}}" data-field="reward.name" value="{{name}}"
                     placeholder="{{localize 'FHQL.Reward.Placeholder'}}" aria-label="{{localize 'FHQL.Reward.Name'}}">
              {{else if linked}}
              <button type="button" class="fhql-link fhql-reward-name" data-action="openDocument" data-uuid="{{uuid}}">{{name}}</button>
              {{else}}
              <span class="fhql-reward-name">{{name}}</span>
              {{/if}}

              {{#if claimable}}
              <span class="fhql-reward-state">
                {{#each claimsList}}
                <span class="fhql-claim"><i class="fa-solid fa-check" inert></i> {{localize "FHQL.Reward.ClaimedBy"}} {{label}}
                  {{#if @root.sheet.gm}}<button type="button" class="fhql-link fhql-undo" data-action="undoClaim" data-claim-index="{{index}}"
                    data-tooltip="{{localize 'FHQL.Reward.Undo'}}" aria-label="{{localize 'FHQL.Reward.Undo'}}"><i class="fa-solid fa-rotate-left" inert></i></button>{{/if}}
                </span>
                {{/each}}
                {{#if showLocked}}<span class="fhql-muted"><i class="fa-solid fa-lock" inert></i> {{localize "FHQL.Reward.LockedNote"}}</span>{{/if}}
                {{#if gmHandsOut}}<span class="fhql-muted"><i class="fa-solid fa-hand-holding-heart" inert></i> {{localize "FHQL.Reward.GMHandsOut"}}</span>{{/if}}
                {{#if perPlayer}}<span class="fhql-muted">{{localize "FHQL.Reward.PerPlayerNote"}}</span>{{/if}}
              </span>
              {{/if}}
            </div>

            <div class="fhql-reward-actions">
              {{#if canClaim}}
              <button type="button" class="fhql-button fhql-small fhql-primary" data-action="claimReward" aria-label="{{claimVerb}}">
                <i class="fa-solid fa-hand-holding" inert></i><span class="fhql-label">{{claimVerb}}</span></button>
              {{/if}}
              {{#if canGive}}
              <button type="button" class="fhql-button fhql-small" data-action="giveReward"
                      data-tooltip="{{localize 'FHQL.Reward.GiveHint'}}" aria-label="{{localize 'FHQL.Reward.Give'}}"><i class="fa-solid fa-hand-holding-heart" inert></i><span class="fhql-label">{{localize "FHQL.Reward.Give"}}</span></button>
              {{/if}}
              {{#if ../gm}}
              {{#if claimable}}
              <button type="button" class="fhql-icon-button {{#unless locked}}is-on{{/unless}}" data-action="toggleRewardLock"
                      aria-pressed="{{#if locked}}false{{else}}true{{/if}}"
                      data-tooltip="{{#if locked}}{{localize 'FHQL.Reward.Unlock'}}{{else}}{{localize 'FHQL.Reward.Lock'}}{{/if}}"
                      aria-label="{{#if locked}}{{localize 'FHQL.Reward.Unlock'}}{{else}}{{localize 'FHQL.Reward.Lock'}}{{/if}}">
                <i class="fa-solid {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}" inert></i></button>
              {{/if}}
              <button type="button" class="fhql-icon-button" data-action="toggleRewardHidden" aria-pressed="{{#if hidden}}true{{else}}false{{/if}}"
                      data-tooltip="{{#if hidden}}{{localize 'FHQL.Reward.Show'}}{{else}}{{localize 'FHQL.Reward.HideAction'}}{{/if}}"
                      aria-label="{{#if hidden}}{{localize 'FHQL.Reward.Show'}}{{else}}{{localize 'FHQL.Reward.HideAction'}}{{/if}}">
                <i class="fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}" inert></i></button>
              {{/if}}
              {{#if ../editing}}
              {{#if claimable}}
              <select class="fhql-input fhql-small-select" data-field="reward.claimLimit" aria-label="{{localize 'FHQL.Reward.LimitLabel'}}"
                      data-tooltip="{{localize 'FHQL.Reward.LimitLabel'}}">
                <option value="once" {{#unless perPlayer}}selected{{/unless}}>{{localize "FHQL.Reward.LimitOnce"}}</option>
                <option value="perPlayer" {{#if perPlayer}}selected{{/if}}>{{localize "FHQL.Reward.LimitPerPlayer"}}</option>
              </select>
              {{/if}}
              <button type="button" class="fhql-icon-button" data-action="deleteReward"
                      data-tooltip="{{localize 'FHQL.Reward.Delete'}}" aria-label="{{localize 'FHQL.Reward.Delete'}}">
                <i class="fa-solid fa-xmark" inert></i></button>
              {{/if}}
            </div>
          </li>
          {{/each}}
        </ul>
        {{#if editable}}
        <div class="fhql-drop-hint">
          <i class="fa-solid fa-hand-pointer" inert></i> {{localize "FHQL.Reward.DropHint"}}
          {{#if editing}}<button type="button" class="fhql-button fhql-small" data-action="addTextReward">
            <i class="fa-solid fa-plus" inert></i> {{localize "FHQL.Reward.AddText"}}</button>{{/if}}
        </div>
        {{/if}}
      </section>
      {{else if editable}}
      <section class="fhql-card fhql-compact fhql-area-rewards" data-drop="rewards">
        <h3 class="fhql-subheading">{{localize "FHQL.Quest.Rewards"}}<span class="fhql-empty-note">{{localize "FHQL.Reward.EmptyHint"}}</span></h3>
      </section>
      {{/if}}
    </div>

    {{! ---------- GM notes ---------- }}
    {{#if gmNotes}}
    <details class="fhql-card fhql-gm-notes" {{#if gmNotes.open}}open{{/if}}>
      <summary>
        <i class="fa-solid fa-chevron-right fhql-chevron" inert></i>
        <i class="fa-solid fa-user-secret" inert></i> {{localize "FHQL.Quest.GMNotes"}}
        <span class="fhql-gm-tag">{{localize "FHQL.Quest.GMOnly"}}</span>
      </summary>
      {{#if editing}}
      <prose-mirror name="gmNotes" data-field="gmNotes" toggled value="{{gmNotes.raw}}">{{{gmNotes.html}}}</prose-mirror>
      {{else if gmNotes.html}}
      <div class="fhql-prose">{{{gmNotes.html}}}</div>
      {{else}}
      <p class="fhql-muted">{{localize "FHQL.Quest.GMNotesEmpty"}}</p>
      {{/if}}
    </details>
    {{/if}}
  </div>
  {{else}}
  <p class="fhql-muted">{{localize "FHQL.Quest.LimitedNote"}}</p>
  {{/if}}
</div>
{{else}}
<p class="fhql-muted fhql-none">{{localize "FHQL.QuestLog.NoneSelected"}}</p>
{{/with}}
</div>
