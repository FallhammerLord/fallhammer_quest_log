{{!-- A one-line text prompt (inputPopover). --}}
<form class="fhql-popover-form">
  <label class="fhql-field"><span>{{label}}</span>
    <input type="text" class="fhql-input" name="value" value="{{value}}" autofocus></label>
  <div class="fhql-popover-buttons">
    <button type="button" class="fhql-button" data-answer="cancel">{{localize "FHQL.Popover.Cancel"}}</button>
    <button type="submit" class="fhql-button fhql-primary">{{ok}}</button>
  </div>
</form>
