{{!-- A chat card: an outcome, a claimed reward, or a deposit. `message` is HTML: callers escape names in it. --}}
<div class="fhql-chat-claim{{#if outcome}} fhql-chat-outcome{{/if}}">
  {{#if img}}<img src="{{img}}" alt="" width="36" height="36">{{/if}}
  <p>{{#if icon}}<i class="fa-solid {{icon}}" inert></i> {{/if}}{{{message}}}</p>
</div>
