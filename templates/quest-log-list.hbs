<nav class="fhql-list" aria-label="{{localize 'FHQL.QuestLog.ListLabel'}}" {{#if gm}}data-folder-drop=""{{/if}}>
  <div class="fhql-toolbar">
    {{#if gm}}
    <div class="fhql-toolbar-row">
      <button type="button" class="fhql-button" data-action="createQuest">
        <i class="fa-solid fa-plus" inert></i> {{localize "FHQL.QuestLog.NewQuest"}}</button>
      <button type="button" class="fhql-icon-button" data-action="createFolder"
              data-tooltip="{{localize 'FHQL.Folders.New'}}" aria-label="{{localize 'FHQL.Folders.New'}}">
        <i class="fa-solid fa-folder-plus" inert></i></button>
    </div>
    {{#if fqlPending}}
    <button type="button" class="fhql-button fhql-import-button" data-action="openFqlImport">
      <i class="fa-solid fa-file-import" inert></i> {{localize "FHQL.Import.Button"}} ({{fqlPending}})</button>
    {{/if}}
    {{else if canPropose}}
    <div class="fhql-toolbar-row">
      <button type="button" class="fhql-button" data-action="createQuest">
        <i class="fa-solid fa-plus" inert></i> {{localize "FHQL.Player.NewQuest"}}</button>
    </div>
    {{/if}}
    {{#if hasQuests}}
    <div class="fhql-search-row">
      <input type="search" class="fhql-input fhql-search" data-list-search value="{{query}}"
             placeholder="{{localize 'FHQL.Filter.Search'}}" aria-label="{{localize 'FHQL.Filter.Search'}}">
      <button type="button" class="fhql-button fhql-small fhql-icon-only" data-action="foldAllFamilies" hidden
              aria-label="{{localize 'FHQL.Family.FoldAll'}}" data-tooltip="{{localize 'FHQL.Family.FoldAll'}}"><i class="fa-solid fa-compress" inert></i></button>
    </div>
    <div class="fhql-chips" role="group" aria-label="{{localize 'FHQL.Filter.Label'}}">
      {{#each statusChips}}
      <button type="button" class="fhql-chip fhql-status-{{status}} {{#if active}}is-on{{/if}}" data-action="toggleStatusFilter"
              data-status="{{status}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" data-tooltip="{{label}}" aria-label="{{label}}">
        <i class="{{icon}} fhql-status-icon" inert></i><span>{{label}}</span></button>
      {{/each}}
    </div>
    {{/if}}
  </div>

  {{#if hasQuests}}
  <ul class="fhql-list-items">
    {{#each items}}
    {{#if folder}}
    <li class="fhql-folder-row {{#if collapsed}}is-collapsed{{/if}}" data-row="folder" data-folder-id="{{id}}" data-chain="{{chain}}"
        {{#if @root.gm}}data-folder-drop="{{id}}"{{/if}} style="--fhql-depth: {{depth}}; --fhql-folder-color: {{#if color}}{{color}}{{else}}var(--fhql-rule){{/if}}">
      <button type="button" class="fhql-folder" data-action="toggleFolder" aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}"
              {{#if outside}}data-tooltip="{{localize 'FHQL.Folders.OutsideHint'}}"{{/if}}>
        <i class="fa-solid fa-chevron-down fhql-folder-chevron" inert></i>
        <i class="fa-solid {{#if outside}}fa-circle-exclamation{{else}}fa-folder{{/if}} fhql-folder-icon" inert></i>
        <span class="fhql-row-name">{{name}}</span>
        <span class="fhql-row-status">{{count}}</span>
      </button>
    </li>
    {{else}}
    <li data-row="quest" data-id="{{id}}" data-parent-id="{{parentId}}" data-status="{{status}}" data-search="{{search}}" data-chain="{{chain}}"
        data-uuid="{{uuid}}" draggable="true" {{#if family}}data-family {{#if familyFinished}}data-family-finished{{/if}}{{/if}}
        class="{{#if level}}is-child{{/if}}" style="--fhql-depth: {{depth}}">
      {{#if family}}
      <button type="button" class="fhql-twisty" data-action="toggleFamily" aria-expanded="true" aria-label="{{toggleLabel}}"
              data-tooltip="{{localize 'FHQL.Family.ToggleHint'}}"><i class="fa-solid fa-chevron-down" inert></i></button>
      {{else}}
      <span class="fhql-twisty-gap"></span>
      {{/if}}
      <button type="button" class="fhql-row fhql-status-{{status}} {{#if selected}}is-selected{{/if}}"
              data-action="selectQuest" data-quest-id="{{id}}" {{#if selected}}aria-current="true"{{/if}}>
        <i class="fhql-status-icon {{statusIcon}}" data-tooltip="{{statusLabel}}" inert></i>
        <span class="fhql-row-name" data-tooltip="{{name}}">{{name}}</span>
        <span class="fhql-row-status">
          {{#if family}}
          {{#if familyUnseen}}{{#unless unseen}}<span class="fhql-new-dot fhql-family-signal" data-tooltip="{{localize 'FHQL.Family.NewInside'}}" aria-label="{{localize 'FHQL.Family.NewInside'}}"></span>{{/unless}}{{/if}}
          {{#if familyFocus}}{{#unless inProgress}}<i class="fa-solid fa-star fhql-in-progress fhql-family-signal" data-tooltip="{{localize 'FHQL.Family.FocusInside'}}" aria-label="{{localize 'FHQL.Family.FocusInside'}}"></i>{{/unless}}{{/if}}
          {{#if familyTracked}}{{#unless tracked}}<i class="fa-solid fa-bookmark fhql-in-progress fhql-family-signal" data-tooltip="{{localize 'FHQL.Family.TrackedInside'}}" aria-label="{{localize 'FHQL.Family.TrackedInside'}}"></i>{{/unless}}{{/if}}
          <span class="fhql-family-count" data-tooltip="{{familyLabel}}" aria-label="{{familyLabel}}">{{familyDone}}/{{familyCount}}</span>
          {{/if}}
          {{#if unseen}}<span class="fhql-new-dot" data-tooltip="{{localize 'FHQL.Seen.New'}}" aria-label="{{localize 'FHQL.Seen.New'}}"></span>{{/if}}
          {{#if inProgress}}<i class="fa-solid fa-star fhql-in-progress" data-tooltip="{{localize 'FHQL.Quest.InProgress'}}" aria-label="{{localize 'FHQL.Quest.InProgress'}}"></i>{{/if}}
          {{#if tracked}}<i class="fa-solid fa-bookmark fhql-in-progress" data-tooltip="{{localize 'FHQL.Beacon.Tracked'}}" aria-label="{{localize 'FHQL.Beacon.Tracked'}}"></i>{{/if}}
          <span class="sr-only">{{statusLabel}}</span>
        </span>
      </button>
    </li>
    {{/if}}
    {{/each}}
  </ul>
  <p class="fhql-muted fhql-no-matches" hidden>{{localize "FHQL.Filter.NoMatches"}}</p>
  {{else}}
  <div class="fhql-empty">
    <p class="fhql-muted">{{localize "FHQL.QuestLog.Empty"}}</p>
    {{#if fqlPending}}
    <button type="button" class="fhql-button fhql-primary" data-action="openFqlImport">
      <i class="fa-solid fa-file-import" inert></i> {{localize "FHQL.Import.Button"}} ({{fqlPending}})</button>
    {{/if}}
    {{#if gm}}
    <button type="button" class="fhql-button" data-action="createSamples">
      <i class="fa-solid fa-flask" inert></i> {{localize "FHQL.QuestLog.AddSamples"}}
    </button>
    {{/if}}
  </div>
  {{/if}}
</nav>
