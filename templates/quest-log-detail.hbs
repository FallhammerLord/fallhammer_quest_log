<article class="fhql-detail">
  {{#with selected}}
  {{#if editing}}
  {{! ---------- Edit mode ---------- }}
  <div class="fhql-mode-bar">
    <span class="fhql-muted"><i class="fa-solid fa-pen" inert></i> {{localize "FHQL.QuestLog.EditingNote"}}</span>
    <button type="button" class="fhql-button fhql-primary" data-action="finishEditing">
      <i class="fa-solid fa-check" inert></i> {{localize "FHQL.QuestLog.Done"}}
    </button>
  </div>
  <header class="fhql-detail-header">
    <input type="text" class="fhql-input fhql-title-input" name="name" data-field="name" value="{{name}}"
           aria-label="{{localize 'FHQL.Quest.Name'}}">
    <div class="fhql-field-row">
      <label class="fhql-field">
        <span>{{localize "FHQL.Quest.Status"}}</span>
        <select class="fhql-input" name="status" data-field="status" {{#unless gm}}disabled{{/unless}}>
          {{#each statusOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
        </select>
      </label>
      {{#if gm}}
      <label class="fhql-check">
        <input type="checkbox" name="inProgress" data-field="inProgress" {{#if inProgress}}checked{{/if}}>
        <span>{{localize "FHQL.Quest.InProgress"}}</span>
      </label>
      {{/if}}
    </div>
    <label class="fhql-field">
      <span>{{localize "FHQL.Quest.Giver"}}</span>
      <input type="text" class="fhql-input" name="giver.name" data-field="giver.name" value="{{giverName}}">
    </label>
  </header>

  <section class="fhql-card">
    <label class="fhql-field">
      <span class="fhql-subheading">{{localize "FHQL.Quest.Description"}}</span>
      <textarea class="fhql-input" name="description" data-field="description" rows="4">{{description}}</textarea>
    </label>
  </section>

  <section class="fhql-card">
    <h3 class="fhql-subheading">
      {{localize "FHQL.Quest.Objectives"}}
      <span class="fhql-muted">{{doneCount}}/{{objectives.length}}</span>
    </h3>
    <ul class="fhql-objectives">
      {{#each objectives}}
      <li class="is-{{state}}" data-objective-id="{{id}}">
        <button type="button" class="fhql-icon-button" data-action="cycleObjective"
                data-tooltip="{{stateLabel}}" aria-label="{{stateLabel}}"><i class="fhql-state-icon {{icon}}" inert></i></button>
        <input type="text" class="fhql-input" name="objective-{{id}}" data-field="objective.name" value="{{name}}"
               placeholder="{{localize 'FHQL.Objective.Placeholder'}}" aria-label="{{localize 'FHQL.Objective.Name'}}">
        {{#if ../gm}}
        <label class="fhql-check" data-tooltip="{{localize 'FHQL.Objective.HiddenHint'}}">
          <input type="checkbox" data-field="objective.hidden" {{#if hidden}}checked{{/if}}>
          <i class="fa-solid fa-eye-slash" inert></i><span class="sr-only">{{localize "FHQL.Objective.Hidden"}}</span>
        </label>
        {{/if}}
        <button type="button" class="fhql-icon-button" data-action="deleteObjective"
                data-tooltip="{{localize 'FHQL.Objective.Delete'}}" aria-label="{{localize 'FHQL.Objective.Delete'}}">
          <i class="fa-solid fa-trash" inert></i></button>
      </li>
      {{/each}}
    </ul>
    <button type="button" class="fhql-button" data-action="addObjective">
      <i class="fa-solid fa-plus" inert></i> {{localize "FHQL.Objective.Add"}}
    </button>
  </section>

  <section class="fhql-card">
    <label class="fhql-field">
      <span class="fhql-subheading">{{localize "FHQL.Quest.PlayerNotes"}}</span>
      <textarea class="fhql-input" name="playerNotes" data-field="playerNotes" rows="3">{{playerNotes}}</textarea>
    </label>
  </section>

  <footer class="fhql-detail-footer">
    {{#if gm}}
    <button type="button" class="fhql-button fhql-danger" data-action="deleteQuest">
      <i class="fa-solid fa-trash" inert></i> {{localize "FHQL.Quest.Delete"}}
    </button>
    {{/if}}
    <button type="button" class="fhql-button fhql-primary" data-action="finishEditing">
      <i class="fa-solid fa-check" inert></i> {{localize "FHQL.QuestLog.Done"}}
    </button>
  </footer>

  {{else}}
  {{! ---------- View mode ---------- }}
  {{#if editable}}
  <div class="fhql-mode-bar">
    <div class="fhql-quick-actions">
      {{#each statusActions}}
      <button type="button" class="fhql-button fhql-status-{{status}}" data-action="setQuestStatus" data-status="{{status}}">
        <i class="{{icon}} fhql-status-icon" inert></i> {{label}}
      </button>
      {{/each}}
    </div>
    <button type="button" class="fhql-button" data-action="editQuest">
      <i class="fa-solid fa-pen" inert></i> {{localize "FHQL.QuestLog.Edit"}}
    </button>
  </div>
  {{/if}}
  <header class="fhql-detail-header">
    <h2 class="fhql-heading">{{name}}</h2>
    <p class="fhql-status-badge fhql-status-{{status}}"><i class="{{statusIcon}}" inert></i> {{statusLabel}}</p>
    {{#if giverName}}<p class="fhql-muted">{{localize "FHQL.Quest.Giver"}}: {{giverName}}</p>{{/if}}
  </header>

  {{#if full}}
  {{#if descriptionHTML}}<section class="fhql-card fhql-prose">{{{descriptionHTML}}}</section>{{/if}}

  {{#if objectives.length}}
  <section class="fhql-card">
    <h3 class="fhql-subheading">
      {{localize "FHQL.Quest.Objectives"}}
      <span class="fhql-muted">{{doneCount}}/{{objectives.length}}</span>
    </h3>
    <ul class="fhql-objectives">
      {{#each objectives}}
      <li class="is-{{state}}" data-objective-id="{{id}}">
        {{#if ../editable}}
        <button type="button" class="fhql-icon-button" data-action="cycleObjective"
                data-tooltip="{{stateLabel}}" aria-label="{{stateLabel}}"><i class="fhql-state-icon {{icon}}" inert></i></button>
        {{else}}
        <i class="fhql-state-icon {{icon}}" aria-label="{{stateLabel}}"></i>
        {{/if}}
        <span>{{name}}</span>
        {{#if hidden}}<i class="fa-solid fa-eye-slash fhql-muted" data-tooltip="{{localize 'FHQL.Objective.Hidden'}}" aria-label="{{localize 'FHQL.Objective.Hidden'}}"></i>{{/if}}</li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  {{#if playerNotes}}
  <section class="fhql-card">
    <h3 class="fhql-subheading">{{localize "FHQL.Quest.PlayerNotes"}}</h3>
    <p class="fhql-prewrap">{{playerNotes}}</p>
  </section>
  {{/if}}
  {{else}}
  <p class="fhql-muted">{{localize "FHQL.Quest.LimitedNote"}}</p>
  {{/if}}
  {{/if}}
  {{else}}
  <p class="fhql-muted">{{localize "FHQL.QuestLog.NoneSelected"}}</p>
  {{/with}}
</article>
