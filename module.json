{
  "id": "fhql",
  "title": "Fallhammer Quest Log",
  "description": "A themeable quest log for players and GMs: subquests, item turn-ins, reward claiming, a Quest Beacon above the players list, and import from Forien's Quest Log. Eight themes: Light, Dark, Sci-fi, Gothic, Cabaret, Hope and Fear (Daggerheart), Noir (Blades in the Dark), and Ledger (Tidy 5e Sheets).",
  "version": "0.3.0",
  "authors": [
    {
      "name": "FallhammerLord",
      "url": "https://github.com/FallhammerLord"
    }
  ],
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "esmodules": [
    "src/main.js"
  ],
  "styles": [
    "styles/fhql.css",
    "styles/components/controls.css",
    "styles/components/list.css",
    "styles/components/sheet.css",
    "styles/components/beacon.css",
    "styles/components/windows.css",
    "styles/components/popovers.css",
    "styles/components/overrides.css",
    "styles/components/contrast.css",
    "styles/components/moments.css",
    "styles/themes/light.css",
    "styles/themes/dark.css",
    "styles/themes/scifi.css",
    "styles/themes/gothic.css",
    "styles/themes/cabaret.css",
    "styles/themes/hopefear.css",
    "styles/themes/noir.css",
    "styles/themes/ledger.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "documentTypes": {
    "JournalEntryPage": {
      "quest": {
        "htmlFields": [
          "description",
          "playerNotes"
        ]
      }
    }
  },
  "url": "https://github.com/FallhammerLord/fallhammer_quest_log",
  "manifest": "https://github.com/FallhammerLord/fallhammer_quest_log/releases/latest/download/module.json",
  "download": "https://github.com/FallhammerLord/fallhammer_quest_log/releases/latest/download/module.zip",
  "bugs": "https://github.com/FallhammerLord/fallhammer_quest_log/issues",
  "license": "LICENSE"
}
